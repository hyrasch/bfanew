// UnitMix (request id Mw08CIg2, encode key JnegC7RrN3FoW8dQ): fusion, sent by
// UnitMixConnectScene::initConnect. Keys from UnitMixRequest::createBody (request) and
// UnitOpeResultResponse::readParam (reply); UnitMixPlayScene::parseMixResult reads the
// level-up records.

json UnitMixInfo {
    doc "Request group 60subGk3"

    field mix_type type="i32::str" {
        key "81GjwoWy"
        doc "1 so far"
    }

    field unit_count type="i32::str" {
        key "2vnqRIr3"
        doc "number of entries in Km35HAXv (base + materials)"
    }
}

json UnitMixCost {
    doc "Request group mCE3rUu5"

    field zel type="i32::str" {
        key "Rs7bCE3t"
        doc "zel the client expects to pay (GameUtils::getMixGold: sum of (base level + material level) * 100)"
    }
}

json UnitMixUnit {
    doc "Request list Km35HAXv: the base first (order 1), then the materials"

    field order type="i32::str" {
        key "mnZ5K4Ii"
        doc "1 = base, 2.. = materials"
    }

    field user_unit_id type="i32::str" {
        key "edy7fq3L"
        doc "TODO"
    }
}

json UnitOpeResult {
    doc "Reply group 1ZbHB6Im (UnitOpeResultResponse::readParam -> UnitOpeResult singleton): what happened to the base unit"

