json FriendPointInfo {
    doc "Top-level 6e4b7sQt -> FriendPointInfoResponse (one node): the friend points a helper earns (each a CSV the client indexes, one value here)"


    field friend_point_num type="i32::str" {
        key "4vamo28W"
        doc "points for a friend (FriendPointInfoResponse::readParam -> setFriendPointNum; ReinforcementInfo::getFriendPoint picks it when FriendInfoList has the helper with type 1)"
    }


    field normal_point_num type="i32::str" {
        key "KgbM81wd"
        doc "points for a helper who is not a friend (-> setNormalPointNum); the picker prints the pick as Honor +N"
    }

}

json FriendGetParam {
    doc "Request group StQIyohe of FriendGet / FriendRandomSearch (sent only when a global flag is set)"


    field deck_no type="i32::str" {
        key "jkldTrhL"
        doc "an int of the request object (+0x20) sent as a string (JsonNode::addParam(int) quotes), 2 from the client"
    }

}

json FriendTarget {
    doc "Request group BPz1e5tU of FriendApply / FriendAgree / FriendDelete"


    field user_id type="str" {
        key "h7eY3sAK"
        doc "the other player user id (16 digits)"
    }

}

json FriendRefuseParam {
    doc "Request group BPz1e5tU of FriendRefuse"


    field user_ids type="str" {
        key "h7eY3sAK"
        doc "user ids joined with commas (Reject All sends every pending request)"
    }


    field all type="str" {
        key "7f3WL6Mx"
        doc "1 for Reject All"
    }

}

json FriendSearchParam {
    doc "Request group BPz1e5tU of FriendSearch"


    field friend_id type="str" {
        key "98WfKiyA"
        doc "the 8-digit ID typed in (UserState::getFriendID)"
    }

}

json FriendRandomParam {
    doc "Request group 3fTYzqT6 of FriendRandomSearch"


    field lv_min type="i32::str" {
        key "3Ug2QynF"
        doc "0"
    }


    field lv_max type="i32::str" {
        key "lzpDckWv"
        doc "100"
    }

}

json FriendFavoriteParam {
    doc "Request group BPz1e5tU of FriendFavorite"


    field user_id type="str" {
        key "h7eY3sAK"
        doc "the friend"
    }


    field favorite type="i32::str" {
        key "5JbjC3Pp"
        doc "1 = favorite, 0 = not"
    }

}

