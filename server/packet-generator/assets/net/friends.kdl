json FriendListResp {
    doc "Every friend request answers this: the list the scene draws next (friends, pending requests, search results), the helper candidates, the friend point values and the wallet"


    field friends type="[FriendInfo]" {
        key "tojMy68W"
        doc "FriendInfoResponse: replaces FriendInfoList"
    }


    field reinforcements type="[ReinforcementInfo]" {
        key "xZH6EIQ7"
        doc "ReinforcementInfoResponse: replaces ReinforcementInfoList (the helper picker non-friends)"
    }


    field point_info type="[FriendPointInfo]::size(1)" {
        key "6e4b7sQt"
        doc "FriendPointInfoResponse"
    }


    field team_info type="[UserTeamInfo]::size(1)" {
        key "fEi17cnx"
        doc "the wallet (friend points, friend counts)"
    }

}
