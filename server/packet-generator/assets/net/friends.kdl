// bfanew: friends (CLAUDE.md "Friends"). Keys read off FriendInfoResponse::readParam /
// ReinforcementInfoResponse::readParam (the strcmp chain -> setter), request bodies off the
// *Request::createBody functions. Every friend record is the leader unit of one helper squad
// (UserUnitInfoBase) plus the friend fields; the client builds helper units from these records.

json FriendInfo {
    doc "One friend (top-level tojMy68W -> FriendInfoResponse, replaces FriendInfoList)"

    field user_id type="str" {
        key "h7eY3sAK"
        doc "the player (16 digits), what every friend request sends back"
    }

    field handle_name type="str" {
        key "B5JQyV8j"
        doc "summoner name"
    }

    field team_lv type="i32::str" {
        key "2Fh3J7ng"
        doc "summoner level"
    }

    field friend_type type="i32::str" {
        key "96Nxs2WQ"
        doc "1 = friend (FriendListUtils::getFriendList keeps type 1), 2 = a request the player sent (Pending), 3 = a request received (Waiting, Accept); the Agree list draws both; 4 = a stranger (the ID and random search scenes list type 4 only)"
    }

    field last_login_date type="i32::str" {
        key "0CAQ6wUe"
        doc "last login as unix seconds (setLastLoginDate(int))"
    }

    field unit_id type="i32::str" {
        key "pn16CNah"
        doc "leader unit of the helper squad"
    }

    field unit_lv type="i32::str" {
        key "4A6LzBxr"
        doc "leader unit level (UserUnitInfoBase::setUnitLv through the vtable)"
    }

    field base_hp type="i32::str" {
        key "e7DK0FQT"
        doc "as in UserUnitInfo"
    }

    field base_atk type="i32::str" {
        key "67CApcti"
        doc "as in UserUnitInfo"
    }

    field base_def type="i32::str" {
        key "q08xLEsy"
        doc "as in UserUnitInfo"
    }

    field base_heal type="i32::str" {
        key "PWXu25cg"
        doc "as in UserUnitInfo"
    }

    field add_hp type="i32::str" {
        key "cuIWp89g"
        doc "as in UserUnitInfo"
    }

    field ext_hp type="i32::str" {
        key "TokWs1B3"
        doc "as in UserUnitInfo"
    }

    field add_atk type="i32::str" {
        key "RT4CtH5d"
        doc "as in UserUnitInfo"
    }

    field ext_atk type="i32::str" {
        key "t4m1RH6Y"
        doc "as in UserUnitInfo"
    }

    field add_def type="i32::str" {
        key "GcMD0hy6"
        doc "as in UserUnitInfo"
    }

    field ext_def type="i32::str" {
        key "e6mY8Z0k"
        doc "as in UserUnitInfo"
    }

    field add_heal type="i32::str" {
        key "C1HZr3pb"
        doc "as in UserUnitInfo"
    }

    field ext_heal type="i32::str" {
        key "X6jf8DUw"
        doc "as in UserUnitInfo"
    }

    field today_yale type="i32::str" {
        key "a1Jp3TVb"
        doc "1 when a gift was already sent to this friend today (FriendInfo::setTodayYale)"
    }

    field want_gift type="str" {
        key "s2WnRw9N"
        doc "the gift the friend asks for (FriendInfo::setWantGift), empty"
    }

    field favorite type="i32::str" {
        key "5JbjC3Pp"
        doc "1 = marked as a favorite (FriendFavorite ps6Vgx4R)"
    }

    field equipitem_id type="i32::str" {
        key "Ge8Yo32T"
        doc "as in UserUnitInfo"
    }

    field equipitem_id2 type="i32::str" {
        key "mZA7fH2v"
        doc "as in UserUnitInfo"
    }

    field friend_id type="str" {
        key "98WfKiyA"
        doc "the 8-digit ID shown in game and typed in the ID search (our account_id)"
    }

    field friend_message type="str" {
        key "bM7RLu5K"
        doc "the player message"
    }

    field friend_message_change_time type="i32::str" {
        key "8DtoZdXE"
        doc "FriendInfo::setFriendMessageChangeTime, 0"
    }

    field arena_rank_id type="str" {
        key "JmFn3g9t"
        doc "arena rank id (FriendInfo::setArenaRankID takes a string)"
    }

    field ranking_point type="i32::str" {
        key "U4pMNjy0"
        doc "arena battle points (FriendInfo::setRankingPoint)"
    }

    field unit_type_id type="i32::str" {
        key "nBTx56W9"
        doc "as in UserUnitInfo"
    }

    field skill_id type="i32::str" {
        key "nj9Lw7mV"
        doc "as in UserUnitInfo"
    }

    field skill_lv type="i32::str" {
        key "3NbeC8AB"
        doc "as in UserUnitInfo"
    }

    field extra_skill_id type="i32::str" {
        key "iEFZ6H19"
        doc "as in UserUnitInfo"
    }

    field extra_skill_lv type="i32::str" {
        key "RQ5GnFE2"
        doc "as in UserUnitInfo"
    }

    field req_time type="str" {
        key "3InKeya4"
        doc "the request date as the Agree list prints it after Date Requested: YYYY/MM/DD HH:MM in the game clock (FriendInfo::setReqTime takes a string)"
    }

    field elapsed_agree_time type="i32::str" {
        key "paND1zM8"
        doc "seconds since the request (FriendInfo::setElapsedAgreeTime)"
    }

    field unk1 type="i32::str" {
        key "7x3pPB2C"
        doc "int through a vtable setter (slot 0x2a8), 0"
    }

    field unk2 type="i32::str" {
        key "Sv80kL5r"
        doc "int through a vtable setter (slot 0x2b8), 0"
    }

    field extra_passive_skill_id type="i32::str" {
        key "cP83zNsv"
        doc "as in UserUnitInfo"
    }

    field extra_passive_skill_id2 type="i32::str" {
        key "LjY4DfRg"
        doc "as in UserUnitInfo"
    }

    field unit_img_type type="i32::str" {
        key "2pAyFjmZ"
        doc "FriendInfo::setUnitImgType, 0"
    }

    field fe_skill_info type="str" {
        key "Fnxab5CN"
        doc "as in UserUnitInfo"
    }

    field deck_no type="i32::str" {
        key "zsiAn9P1"
        doc "the helper squad number this leader comes from (FriendInfo::setDeckNo)"
    }

    field priority type="i32::str" {
        key "yu18xScw"
        doc "FriendInfo::setPriority; FriendInfoList::getCountAgreeOk counts friends with priority <= 1"
    }

    field unk3 type="i32::str" {
        key "jkldTrhL"
        doc "int at +0x250, 0"
    }

    field unk4 type="i32::str" {
        key "9i2xhMaJ"
        doc "int at +0x254, 0"
    }

    field element type="i32::str" {
        key "iNy0ZU5M"
        doc "int at +0x258 (the unit box sends the element here)"
    }

    field unk5 type="str" {
        key "btZizNep"
        doc "string at +0x260, empty"
    }

    field unk6 type="str" {
        key "RVVgyuor"
        doc "string at +0x278, empty"
    }

    field unk7 type="i32::str" {
        key "U8FCB2Wj"
        doc "int at +0x290, 0"
    }

    field unk8 type="i32::str" {
        key "NqVAPbLC"
        doc "int at +0x294, 0"
    }

    field unk9 type="str" {
        key "mgNdrCEe"
        doc "string at +0x298, empty"
    }

    field guild_id type="i32::str" {
        key "sD73jd20"
        doc "FriendInfo::setGuildID, 0"
    }

    field omni_level type="i32::int" {
        key "49sa3sld"
        doc "as in UserUnitInfo"
    }

}

