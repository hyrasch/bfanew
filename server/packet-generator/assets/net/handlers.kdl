json GachaActionParam {
    doc "Which summon the client wants to perform (GachaActionRequest::createBody)"

    field gacha_id type="i32::str" {
        key "7Ffmi96v"
        doc "GachaInfoMst / GachaMst id"
    }

    field request_count type="i32::str" {
        key "a329kbl8"
        doc "UserState::noOfGachaRequests, 1 for a single summon"
    }

    field use_ticket type="i32::str" {
        key "324b023k"
        doc "UserState::isUsingGachaTicket"
    }
}

json GachaActionReq {
    doc "GachaAction command (request id F7JvPk5H): perform a summon"

