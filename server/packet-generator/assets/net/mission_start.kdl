    doc "Reply list n64NOpfy: extra sprite parts of multi-part enemies (BattleMonsterGroupPartsMstResponse::readParam); empty for plain unit-based enemies"

    field battle_monster_group_id type="str" {
        key "Qzhp8B40"
        doc "TODO"
    }

    field monster_id type="str" {
        key "o49dYfpH"
        doc "TODO"
    }

    field main_body_flg type="i32::str" {
        key "7Hf3DnVj"
        doc "TODO"
    }

    field z_order type="i32::str" {
        key "2gZIRQ7D"
        doc "TODO"
    }

    field img_anime type="str" {
        key "2EF0d6ue"
        doc "TODO"
    }

    field img_cgg type="str" {
        key "QqfI9mM4"
        doc "TODO"
    }

    field img_cgs type="str" {
        key "0QxL2is7"
        doc "TODO"
    }

    field target_area type="str" {
        key "8GNxt1XE"
        doc "TODO"
    }
}

json MonsterMst {
    doc "Reply list U0v5IeJo: the enemies' stats (MonsterMstResponse::readParam). Keys shared with F_UNIT_MST use the unit table's formats. With a unit_id the sprites come from the unit's files (GameUtils::getMonsterAnmImage: unit_anime_<id>), img_a / anm_cgg are for monster-only sprites."

    field monster_id type="str" {
        key "o49dYfpH"
        doc "row id, referenced by BattleMonsterGroupMst"
    }

    field name type="str" {
        key "3evIn0zZ"
        doc "shown in battle"
    }

    field hp type="i32::str" {
        key "e7DK0FQT"
        doc "TODO"
    }

    field atk type="i32::str" {
        key "67CApcti"
        doc "TODO"
    }

    field def type="i32::str" {
        key "q08xLEsy"
        doc "TODO"
    }

    field element type="i32::str" {
        key "iNy0ZU5M"
        doc "1 fire, 2 water, 3 earth, 4 thunder, 5 light, 6 dark"
    }

    field effect_frame type="str" {
        key "eyUo6a8c"
        doc "like F_UNIT_MST effectFrames, e.g. 24:123:1"
    }

    field damage_frame type="str" {
        key "6Aou5M9r"
        doc "like F_UNIT_MST damageFrames, e.g. 30:100:2:1"
    }

    field drop_check_cnt type="i32::str" {
        key "n9h7p02P"
        doc "hits per attack that can drop BC/HC (unit dropCheckCount)"
    }

    field exp type="i32::str" {
        key "d96tuT2E"
        doc "TODO"
    }

    field amount type="i32::str" {
        key "Rs7bCE3t"
        doc "TODO"
    }

    field img_a type="str" {
        key "2EF0d6ue"
        doc "monster-only sprite sheet, empty with unit_id"
    }

    field anm_cgg type="str" {
        key "QqfI9mM4"
        doc "monster-only cgg, empty with unit_id"
    }

    field unit_id type="str" {
        key "pn16CNah"
        doc "F_UNIT_MST unitId whose sprites and BB this enemy uses"
    }

    field description type="str" {
        key "qp37xTDh"
