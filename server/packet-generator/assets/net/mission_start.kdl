json MissionBattleData {
    doc "bfanew: one deploy/battle/<mission_id>.json, built by tools/build_battles.py from the 2014 datamine captures. The lists are sent as-is in the MissionStart reply."

    field energy_use type="i32::int" {
        key "energy_use"
        doc "F_MISSION_MST missionEnergyUse"
    }

    field battle_count type="i32::int" {
        key "battle_count"
        doc "number of battles"
    }

    field exp type="i32::int" {
        key "exp"
        doc "player exp for clearing (missions.json xp)"
    }

    field zel type="i32::int" {
        key "zel"
        doc "zel reward for clearing"
    }

    field karma type="i32::int" {
        key "karma"
        doc "karma reward for clearing"
    }

    field unlocks type="[MissionUnlock]" {
        key "unlocks"
        doc "places opened by clearing this mission"
    }

    field battle_groups type="[BattleGroupMst]" {
        key "pj41dy9g"
        doc "TODO"
    }

    field monster_groups type="[BattleMonsterGroupMst]" {
        key "75t0sx9z"
        doc "TODO"
    }

    field parts type="[BattleMonsterGroupPartsMst]" {
        key "n64NOpfy"
        doc "TODO"
    }

    field monsters type="[MonsterMst]" {
        key "U0v5IeJo"
        doc "TODO"
    }

    field ai type="[AIMst]" {
        key "89ausgc4"
        doc "TODO"
    }

    field skills type="[MonsterSkillMst]" {
        key "m9Ada1PN"
