        doc "TODO"
    }

    field hp_disp_pos type="str" {
        key "3BpHN6VD"
        doc "x,y HP bar offset like unit 3BpHN6VD"
    }

    field passive_process_id type="str" {
        key "hjAy9St3"
        doc "TODO"
    }

    field passive_process_param type="str" {
