    field ai_id type="str" {
        key "i74vGUFa"
        doc "AIMst rows with this id drive the enemy"
    }

    field after_image type="i32::str" {
        key "D4Y5bWK7"
        doc "unit D4Y5bWK7"
    }

    field max_act_cnt type="i32::str" {
        key "oMGC3hW0"
        doc "actions per turn, max"
    }

    field min_act_cnt type="i32::str" {
        key "m4EK7Gt6"
        doc "actions per turn, min"
    }

    field act_rate type="i32::str" {
        key "6fwL59FT"
        doc "TODO"
    }

    field monster_skill_id type="str" {
        key "F4bQ7r8C"
        doc "MonsterSkillMst id, empty = the unit's own BB (BattleUnit::setUnitSkill)"
    }

    field skill_move_type type="i32::str" {
        key "XE7Yi5c3"
