// MissionStart (request id jE6Sp0q4): the client's "Begin Quest". Everything here was read
// off the 2.19.6.0 client: MissionStartRequest::createBody for the request, the *Response::readParam
// parsers for the reply (key -> setter), MonsterParty::entryMonsters / MonsterUnit::initialize for the
// string formats. See bfanew/CLAUDE.md "MissionStart contract".

json MissionStartParam {
    doc "Request group 9Q1Lq5FS"

    field reinforce_user_id type="str" {
        key "h7eY3sAK"
        doc "UserState::getReinforcementUserID, 0 when no helper was picked"
    }

    field friend_point type="i32::str" {
        key "J3stQ7jd"
        doc "UserState::getFriendPoint (friend points the helper costs)"
    }

    field mission_id type="i32::str" {
        key "j28VNcUW"
        doc "UserState::getLastMissionID"
    }

    field unk type="str" {
        key "jkldTrhL"
        doc "always 0 so far"
    }

    field deck_num type="i32::str" {
        key "Z0Y4RoD7"
        doc "squad number used"
    }

    field quest_bonus_type type="i32::str" {
        key "nA95Bdj6"
        doc "UserState::getQuestBonusType"
    }

    field quest_bonus_rate type="str" {
        key "5Z1LNoyH"
        doc "UserState::getQuestBonusRate"
    }

    field reinforce_deck_no type="i32::str" {
        key "u1iPEVUq"
        doc "helper deck number, -1 without helper"
    }

    field reinforce_info type="str" {
        key "1VagK32J"
        doc "helper unit info, only with a helper"
        optional #true
    }
}

json MissionStartInfo {
    doc "Reply group 9Q1Lq5FS (MissionStartInfoResponse::readParam -> MissionStartInfo singleton)"

    field reinforce_user_id type="str" {
        key "h7eY3sAK"
        doc "echo of the request"
    }

    field friend_point type="i32::str" {
        key "J3stQ7jd"
        doc "friend points after the helper was paid"
    }

    field mission_id type="i32::str" {
        key "j28VNcUW"
        doc "echo of the request"
    }

    field reinforce_info type="str" {
        key "1VagK32J"
        doc "helper unit info, empty without helper"
    }

    field deck_num type="i32::str" {
        key "Z0Y4RoD7"
        doc "echo of the request"
    }
}

json MissionNum {
    doc "Reply group Kz7qfSs5 (MissionNumResponse::readParam -> MissionInfo). The serial id identifies this run of the mission; MissionStartScene::updateEvent refuses an empty one (INVALID_MISSION_SERIAL_ID)."

    field serial_id type="str" {
        key "k9cxD7Ba"
        doc "MissionInfo::setMissionSerialID"
    }

    field bonus_type type="i32::str" {
        key "nA95Bdj6"
        doc "MissionInfo::setBonusType (0 none, zel/karma bonus events)"
    }

    field bonus_rate type="str" {
        key "5Z1LNoyH"
        doc "MissionInfo::setBonusRate (float)"
    }

    field drop_info type="str" {
        key "LE6JkUp7"
        doc "MissionDropInfoList::parse: per battle order|unitDropInfo|treasureBoxInfo joined with @; empty = no fixed drops"
    }
}

json BattleGroupMst {
    doc "Reply list pj41dy9g: one row per battle of the mission (BattleGroupMstResponse::readParam)"

    field battle_group_id type="str" {
        key "ZSf8e1MG"
        doc "row id"
    }

    field battle_monster_group_id type="str" {
        key "Qzhp8B40"
        doc "the BattleMonsterGroupMst rows of this battle"
    }

    field mission_id type="str" {
        key "j28VNcUW"
        doc "F_MISSION_MST missionId"
    }

    field battle_order type="i32::str" {
        key "VETu07N6"
        doc "1-based battle number"
    }

    field boss_flg type="i32::str" {
        key "etM5TCb9"
        doc "1 on the boss battle"
    }

    field first_attack_rate type="str" {
        key "5aetPz3C"
        doc "float, chance the enemies act first"
    }

    field unk type="i32::str" {
        key "mFxqsc7Y"
        doc "7th key, no setter found; 0"
    }
}

json BattleMonsterGroupMst {
    doc "Reply list 75t0sx9z: one row per enemy on the field (BattleMonsterGroupMstResponse::readParam)"

    field battle_monster_group_id type="str" {
        key "Qzhp8B40"
        doc "group this enemy belongs to"
    }

    field monster_id type="str" {
        key "o49dYfpH"
        doc "MonsterMst row"
    }

    field group_order type="i32::str" {
        key "hZtF1s8B"
        doc "MonsterUnit::setGroupOrder, 1-based slot in the group"
    }

    field position type="str" {
        key "3g8PW6x0"
        doc "x:y in the 640x440 battle field (MonsterParty::entryMonsters: StrToFloat * 0.5 -> BattleUnit::setX/setY)"
    }

    field item_drop type="str" {
        key "i30R8TAs"
        doc "MonsterParty::setMaterialDrop: percent:itemId:rest entries joined with a comma; empty = none"
    }

    field unit_drop type="str" {
        key "hw3L0uVj"
        doc "unit capture info, empty = none"
    }

    field treasure_drop type="str" {
        key "5wB9SHAV"
        doc "treasure chest info (MissionScene::getMaxRewardZel/Karma read it), empty = none"
    }
}

