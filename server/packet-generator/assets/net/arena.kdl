// bfanew: the classic Arena (PvP auto-battles against other summoners' squads), as the 2.19.6
// client plays it. Scenes: ArenaTopConnectScene sends ArenaStart on entry; the top scene's Battle
// button sends ArenaMatching and shows the ONE suggested enemy (ArenaSuggestEnemyScene, "Next"
// re-rolls with another ArenaMatching); Fight -> ArenaBattleStartConnectScene -> ArenaBattleStart,
// whose reply carries both squads as the NPC JSON strings the battle parses (NpcTeamParse /
// NpcPartyParseList / NpcUnitParseList, picojson); the battle runs on the client; its end sends
// ArenaBattleEnd with the battle log and reads back the result, the rewards and the arena record.
// Every key below was read off the *Response::readParam / *Request::createBody functions.

json UserArenaInfo {
    doc "The player's arena record (UserInfo 8jBJ7uKR and every arena reply; UserArenaInfoResponse::readParam). A non-empty battle id means a battle is in progress: ArenaInfoConnectScene::arenaBattleTheWay resumes it (ArenaBattleRestart)."

    field user_id type="str" {
        key "h7eY3sAK"
        doc "TODO"
    }

    field arena_rank_id type="i32::str" {
        key "JmFn3g9t"
        doc "ArenaRankMst id (arena_rank.json: points bands, 1 Rookie ... )"
    }

    field rank_point type="i32::str" {
        key "U4pMNjy0"
        doc "ABP, arena battle points"
    }

    field battle_cnt type="i32::str" {
        key "69vnphig"
        doc "battles fought"
    }

    field win_cnt type="i32::str" {
        key "8CEu9Kcm"
        doc "battles won"
    }

    field battle_cnt_accept type="i32::str" {
        key "20iEWRCV"
        doc "battles fought as the defender"
    }

    field win_cnt_accept type="i32::str" {
        key "0rAkzg7L"
        doc "battles won as the defender"
    }

    field max_arena_rank_id type="str" {
        key "8uJ1XGwx"
        doc "highest rank reached (setMaxArenaRankID; the top scene compares it with the rank for the rank-up reward marker)"
    }

    field current_position type="i32::str" {
        key "2rqxaZ6K"
        doc "ranking position"
    }

    field battle_id type="str" {
        key "xL0p2MkY"
        doc "the battle in progress, empty when none"
    }
}

