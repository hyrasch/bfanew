json ArenaBattleEnemyInfo {
    doc "The opponent's squad for the battle (ArenaBattleStart / ArenaBattleRestart reply 9NX83YVe, ArenaBattleEnemyInfoResponse::readParam -> ArenaBattleEnemyInfo). team_info / party_info / unit_info are JSON strings in the NPC format (RivalParty::entry): team {P_USER_ID, P_LV, P_FRIEND_MESSAGE, P_GUILD_ID}, party [{P_USER_UNIT_ID, P_MEMBER_TYPE (0 = leader), P_DISPORDER (slot 0-4)}], units [{P_USER_UNIT_ID, P_UNIT_ID, P_UNIT_TYPE_ID, P_LV, P_HP, P_ATK, P_DEF, P_HEL, P_SKILL_ID, P_SKILL_LV, P_EXTRA_SKILL_ID, P_EXTRA_SKILL_LV, P_EXTRA_PASSIVE_SKILL_ID, P_EXTRA_PASSIVE_SKILL_ID2, P_ADD_HP, P_EXT_HP, P_ADD_ATK, P_EXT_ATK, P_ADD_DEF, P_EXT_DEF, P_ADD_HEL, P_EXT_HEL, P_EQP_ITEM_ID, P_EQP_ITEM_ID2, P_IMG_TYPE, P_FE_INFO, P_OMNI_LV}], every value a string."

    field user_id type="str" {
        key "h7eY3sAK"
        doc "TODO"
    }

    field battle_id type="i32::str" {
        key "xL0p2MkY"
        doc "setBattleID"
    }

    field team_info type="str" {
        key "INT1K9Pf"
        doc "NPC team JSON"
    }

    field party_info type="str" {
        key "nZc1Ip3N"
        doc "NPC party JSON"
    }

    field unit_info type="str" {
        key "U42YcFNu"
        doc "NPC units JSON"
    }

    field friend_message type="str" {
        key "bM7RLu5K"
        doc "TODO"
    }

    field rule type="i32::str" {
        key "IvuccUuD"
        doc "UserArenaRuleInfo::setRule: an ArenaExtraRuleMst id, 0 = none"
    }
}

